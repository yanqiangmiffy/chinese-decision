# 复制为 deploy/gpu/deploy.env 后填写（deploy.env 已加入 .gitignore，不会提交）。
# 写成 ${VAR:-默认值}，命令行上临时给的变量（如 GPU=5 deploy/gpu/deploy.sh）仍然优先。
HOST=${HOST:-user@gpu-server.example.com}   # SSH 目标
SSH_PORT=${SSH_PORT:-22}
KEY=${KEY:-$HOME/.ssh/id_ed25519}            # SSH 私钥
REMOTE=${REMOTE:-decision-service}          # 服务器上的部署目录（相对 home 或绝对路径）
PROJECT=${PROJECT:-/data/chinese-decision}  # 服务器上的训练仓库：.venv、models/Qwen3.5-0.8B、runs/cj-ddp
GPU=${GPU:-2}
PORT=${PORT:-8003}
